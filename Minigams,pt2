<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Meme Noise Site</title>
  <style>
    body {
      margin: 0;
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      font-family: sans-serif;
      color: white;
      text-align: center;
      background: black;
      transition: background-color 0.1s ease-in-out;
    }
    h1 {
      font-size: 2em;
    }
  </style>
</head>
<body>
  <h1>💥 Welcome to the Meme Noise Site! 💥<br>
  Try closing the tab... we dare you 😈</h1>

  <script>
    // Play weird looping noise
    const sound = new Audio("https://www.myinstants.com/media/sounds/vine-boom.mp3");
    sound.loop = true;
    sound.volume = 0.5;
    sound.play();

    // Fake money notifications
    let money = 0;
    function showMoneyNotification() {
      if ("Notification" in window && Notification.permission === "granted") {
        new Notification(`🤑 You earned $${++money}!`);
      }
    }

    if ("Notification" in window) {
      Notification.requestPermission().then(permission => {
        if (permission === "granted") {
          setInterval(showMoneyNotification, 1000);
        }
      });
    }

    // Flashing background
    setInterval(() => {
      const r = Math.floor(Math.random() * 256);
      const g = Math.floor(Math.random() * 256);
      const b = Math.floor(Math.random() * 256);
      document.body.style.backgroundColor = `rgb(${r}, ${g}, ${b})`;
    }, 100);
  </script>
</body>
</html>
